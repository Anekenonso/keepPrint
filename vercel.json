{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/aholo-global/:path*",
      "destination": "/api/aholo-global"
    },
    {
      "source": "/api/aholo-cn/:path*",
      "destination": "/api/aholo-cn"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
