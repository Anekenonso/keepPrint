# Aholo Lux3D API Key (from labs.aholo.ai)
# For local dev and Vercel edge deployment, AHOLO_API_KEY is shielded server-side
AHOLO_API_KEY=your_key_here

# Region (com or cn - defaults to com)
VITE_AHOLO_REGION=com

# Optional direct client fallback (only if hosting strictly static without reverse proxy)
# VITE_AHOLO_API_KEY=your_key_here

# Canonical application URL
VITE_APP_URL=http://localhost:5173
